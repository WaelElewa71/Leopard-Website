# Public origin used for absolute metadata and deployment checks.
NEXT_PUBLIC_SITE_URL=

# PostgreSQL 17+ connection owned by Leopard. Use separate restricted credentials per environment.
# This credential matches the local Compose default only. Replace it outside local development.
DATABASE_URL=postgresql://leopard_app:local_dev_only_change_me@localhost:5432/leopard?schema=public
POSTGRES_PASSWORD=local_dev_only_change_me

# Required for stable, privacy-preserving RFQ rate-limit keys. Generate a random 32+ byte secret.
RATE_LIMIT_HMAC_SECRET=replace_with_random_secret_at_least_32_bytes
PRIVACY_NOTICE_APPROVED=false

# Optional future integrations. Do not commit real values.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SHARED_SECRET=
EMAIL_PROVIDER=
EMAIL_API_KEY=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
